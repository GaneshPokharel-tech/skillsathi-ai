
# SkillSathi AI | Environment Configuration
#
# Copy this file to .env:
# cp .env.example .env
#
# Add your own API key to .env.
# Never commit .env to GitHub.

# Required: Google Gemini API key
GEMINI_API_KEY=

# Optional: Gemini model override
# GEMINI_MODEL=

# Enable automatic website synchronization
# 0 = disabled
# 1 = enabled
SKILLSHIKSHYA_AUTO_SYNC_ENABLED=0

# Website synchronization interval (hours)
SKILLSHIKSHYA_AUTO_SYNC_INTERVAL_HOURS=6
